{
  "name": "stridon-presentational-websites",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev:sg": "turbo dev --filter=sg-tools-storefront",
    "dev:dck": "turbo dev --filter=dck-storefront",
    "dev:stridon": "turbo dev --filter=stridon-storefront",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "preflight": "turbo lint test",
    "generate:types": "openapi-typescript http://localhost:5000/swagger/storefront/swagger.json -o packages/shared/src/types/api.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "turbo": "^2"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.47.0"
  }
}
